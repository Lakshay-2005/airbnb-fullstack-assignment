# SQLite file location (relative to backend/ or absolute)
DATABASE_URL=sqlite:///./airbnb_clone.db
# Comma-separated list of allowed browser origins (add your deployed frontend URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
# Secret used to sign demo-session tokens. Change in production.
SECRET_KEY=change-me-in-production
# Seed demo data automatically when the database is empty
AUTO_SEED=true
